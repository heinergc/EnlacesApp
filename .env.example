# Variables de entorno para la aplicación
# Copia este archivo a .env y configura tus valores

# Clave secreta de Flask (genera una segura para producción)
SECRET_KEY=tu-clave-secreta-super-segura-aqui

# Entorno de Flask
FLASK_ENV=production

# Puerto (Render lo configura automáticamente)
PORT=5000

# ====================================================
# Google OAuth Credentials
# ====================================================
# Obtén estas credenciales desde:
# https://console.cloud.google.com/apis/credentials
#
# Pasos para configurar Google OAuth:
# 1. Ve a https://console.cloud.google.com/
# 2. Crea un nuevo proyecto o selecciona uno existente
# 3. Habilita la API de Google+ (Google+ API)
# 4. Ve a "Credenciales" → "Crear credenciales" → "ID de cliente de OAuth"
# 5. Configura la pantalla de consentimiento si es necesario
# 6. Tipo de aplicación: "Aplicación web"
# 7. Agrega los URIs de redirección autorizados:
#    - http://localhost:5000/authorize (desarrollo local)
#    - https://tu-app.onrender.com/authorize (producción)
# 8. Copia el Client ID y Client Secret aquí

GOOGLE_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-google-client-secret

# ====================================================
# Base de datos (opcional en desarrollo)
# ====================================================
# En desarrollo se usa SQLite por defecto
# En producción (Render), se configura automáticamente
# DATABASE_URL=sqlite:///enlaces.db
